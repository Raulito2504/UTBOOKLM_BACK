# Puedes usar DATABASE_URL completa o los campos separados de abajo.
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/utbooklm
APP_ENV=development
# Optional. Defaults to INFO in development and WARNING in production.
LOG_LEVEL=
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=utbooklm
JWT_SECRET_KEY=change-this-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
# Development only. Production and staging must use AUTH_ENABLED=true.
AUTH_ENABLED=false
GOOGLE_AUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
FRONTEND_AUTH_CALLBACK_URL=http://localhost:3000/auth/callback
CORS_ORIGINS=http://localhost:3000
DOCUMENT_STORAGE_BACKEND=local
DOCUMENT_STORAGE_DIR=storage/documents
DOCUMENT_MAX_UPLOAD_MB=50
DOCUMENT_ALLOWED_EXTENSIONS=pdf,pptx
DOCUMENT_ALLOWED_MIME_TYPES=application/pdf,application/vnd.openxmlformats-officedocument.presentationml.presentation
# Para despliegue usa DOCUMENT_STORAGE_BACKEND=s3 o DOCUMENT_STORAGE_BACKEND=minio.
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_REGION_NAME=
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=documents
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CHROMA_PERSIST_DIR=storage/chroma
EMBEDDING_PROVIDER=fake
EMBEDDING_MODEL=text-embedding-3-small
LLM_PROVIDER=fake
LLM_MODEL=gpt-4o
OPENAI_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_ENABLED=false
EMAIL_PROVIDER=brevo
EMAIL_FROM=noreply@example.com
EMAIL_FROM_NAME=UTBookLM
FRONTEND_PASSWORD_RESET_URL=http://localhost:3000/reset-password
BREVO_API_KEY=
WEBSOCKET_TOKEN_EXPIRE_MINUTES=5
